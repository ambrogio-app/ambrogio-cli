#!/bin/sh
# Block commits that add secrets or leave the model of the workspace invalid. Enable once per clone:
#   git config core.hooksPath .githooks
# The model checks run from the ambrogio-model checkout next to this repository.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'pre-commit: gitleaks not found on PATH; commit blocked.' >&2
  echo 'Install gitleaks 8.30.1 from https://github.com/gitleaks/gitleaks/releases and add it to PATH.' >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner . || exit 1
checks="$(git rev-parse --show-toplevel)/../ambrogio-model/scripts/model-checks"
if [ ! -x "$checks" ]; then
  echo 'pre-commit: ambrogio-model is not next to this repository; clone https://github.com/ambrogio-app/ambrogio-model beside it and retry.' >&2
  exit 1
fi
exec "$checks"
