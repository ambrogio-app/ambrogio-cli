#!/bin/sh
# Block commits that add secrets. Enable once per clone:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo 'pre-commit: gitleaks not found on PATH; commit blocked.' >&2
  echo 'Install gitleaks 8.30.1 from https://github.com/gitleaks/gitleaks/releases and add it to PATH.' >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
