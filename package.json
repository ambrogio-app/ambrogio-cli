{
  "name": "ambrogio-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/cli.js",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "test:backend": "pnpm build && node scripts/verify-pinned-backend.mjs"
  },
  "dependencies": {
    "terminal-kit": "3.1.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/terminal-kit": "2.5.7",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24"
  }
}
